{
  "name": "moneyszn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "node scripts/build-test-fixtures.mjs && playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
